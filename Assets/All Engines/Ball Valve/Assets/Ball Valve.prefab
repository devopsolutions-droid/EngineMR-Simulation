  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u25CF<indent=10>Ball valves are rotary motion-actuated valves used to
    control fluid flow.</indent>\n\u25CF<indent=10>A ball with a hole through the
    middle is installed within the body. A handle is used to indicate the position
    of the valve.</indent>\n\u25CF<indent=10>If the ball is in-line with the flow,
    the valve is said to be in the open position and there is a resistance to flow.</indent>\n\u25CF<indent=10>If
    the ball is rotated 90 degrees and is perpendicular to the flow direction, the
    valve is said to be in the closed position and there is no flow.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e63ac0177aeed334f9a24408402d8fb6, type: 2}
  m_sharedMaterial: {fileID: 1749380657243123591, guid: e63ac0177aeed334f9a24408402d8fb6,
