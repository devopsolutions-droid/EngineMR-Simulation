  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u25CF<indent=10>Progressive cavity pump is unique and reliable construction,
    which makes it much more exclusive to use high viscous fluids (like oil, petrol,
    diesel etc.)</indent>\n\u25CF<indent=10>The progressive cavity pump is typically
    made up of a helical rotor and a twin helix with a helical hole twice the wavelength
    of the stator hole. The rotor seals tightly against the stator as it rotates,
    forming a set of fixed-size cavities in between. When the rotor rotates, the
    cavities move, but their shape or volume remains unchanged. The pumped material
    is moved inside the cavities.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e63ac0177aeed334f9a24408402d8fb6, type: 2}
  m_sharedMaterial: {fileID: 1749380657243123591, guid: e63ac0177aeed334f9a24408402d8fb6,
